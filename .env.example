POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgres://house:change-this-database-password@localhost:5432/house_studio
APP_DOMAIN=studio.example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-launch
OPENAI_API_KEY=
# Optional; provider credentials can instead be configured by the admin in Settings.
OPENAI_TEXT_MODEL=gpt-6.1-sol
PUBLIC_BASE_URL=
RENDER_DIR=./render-output
# Required in production: stable 32-byte base64 key or 64-character hex key.
# In local development only, a key is generated in .secrets/credentials.key.
CREDENTIAL_ENCRYPTION_KEY=
# Hosted writable files live below this persistent mount; leave blank locally.
DATA_DIR=
PORT=3001
UPLOAD_DIR=./uploads
NODE_ENV=development
