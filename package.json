{
  "name": "house-concept-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {"node": ">=22 <23"},
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file=.env --import tsx server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --target=node22 --packages=external --outfile=dist-server/index.cjs",
    "start": "node --env-file-if-exists=.env dist-server/index.cjs",
    "download:assets": "python scripts/download-free-assets.py",
    "verify:assets": "python scripts/validate-free-assets.py",
    "smoke:local": "node --env-file=.env --import tsx scripts/local-smoke.ts",
    "test": "node --require ./scripts/test-user-info.cjs --import tsx --test server/*.test.ts src/*.test.ts src/house3d/*.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "fastify": "^5.0.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.181.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.181.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
